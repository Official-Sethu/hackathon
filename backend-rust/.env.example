# Gonka Router API Gateway Configuration Template
GONKA_BASE_URL=https://gonkarouter.io/v1

# Distributed Key Pool (Insert your keys on server deployment)
GONKA_API_KEY_1=sk-your-primary-key-here
GONKA_API_KEY_2=sk-your-secondary-key-here
GONKA_API_KEY_3=sk-your-tertiary-key-here

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECS=60
